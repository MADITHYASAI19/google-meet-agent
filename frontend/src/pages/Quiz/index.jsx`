import React from 'react';
import { Card, Button } from '../ui/common';
import { useQuiz } from '../../hooks/useQuiz';
import { LuBookOpen, LuTrophy, LuTimer, LuCpu } from 'react-icons/lu';
import { useNavigate } from 'react-router-dom';

const QuizPage = () => {
  const { meetingId } = useParams(); // This should be passed via route
  const navigate = useNavigate();
  const { quiz, loading, error } = useQuiz(meetingId);

  if (loading) return <div className="p-8 text-center">Loading Quiz...</div>;
  if (error) return <div className="p-8 text-center text-red-500">{error}</div>;

  return (
    <div className="max-w-4xl mx-auto flex flex-col gap-8">
      <header>
        <h1 className="text-3xl font-bold text-gray-900 dark:text-white">AI Generated Quiz</h1>
        <p className="text-gray-500 dark:text-gray-400">Test your knowledge on the lecture materials.</p>
      </header>

      <div className="grid grid-cols-1 md:grid-cols-3 gap-6">
        <Card className="md:col-span-2 p-6">
          <h3 className="text-xl font-bold dark:text-white mb-6">Quiz Overview</h3>
          <div className="grid grid-cols-2 gap-6">
            <div className="flex items-center gap-3">
              <div className="p-2 bg-primary-100 dark:bg-primary-900 text-primary-600 rounded-lg"><LuBookOpen /></div>
              <div>
                <p className="text-xs text-gray-500">Total Questions</p>
                <p className="font-bold dark:text-white">{quiz?.questions?.length || 0}</p>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <div className="p-2 bg-green-100 dark:bg-green-900 text-green-600 rounded-lg"><LuTimer /></div>
              <div>
                <p className="text-xs text-gray-500">Est. Time</p>
                <p className="font-bold dark:text-white">{quiz?.estimated_time || 15} mins</p>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <div className="p-2 bg-orange-100 dark:bg-orange-900 text-orange-600 rounded-lg"><LuTrophy /></div>
              <div>
                <p className="text-xs text-gray-500">Difficulty</p>
                <p className="font-bold dark:text-white">{quiz?.difficulty || 'Medium'}</p>
              </div>
            </div>
            <div className="flex items-center gap-3">
              <div className="p-2 bg-purple-100 dark:bg-purple-900 text-purple-600 rounded-lg"><LuCpu /></div>
              <div>
                <p className="text-xs text-gray-500">AI Model</p>
                <p className="font-bold dark:text-white">{quiz?.model || 'GPT-4'}</p>
              </div>
            </div>
          </div>

          <Button
            className="w-full mt-8 py-4 text-lg"
            onClick={() => navigate(`/quiz/player/${meetingId}`)}
          >
            Start Quiz Now
          </Button>
        </Card>

        <Card className="p-6">
          <h3 className="text-lg font-bold dark:text-white mb-4">Quick Stats</h3>
          <div className="space-y-4">
            <div className="flex justify-between text-sm">
              <span className="text-gray-500">Question Types</span>
              <span className="dark:text-white font-medium">Mixed</span>
            </div>
            <div className="flex justify-between text-sm">
              <span className="text-gray-500">Passing Score</span>
              <span className="dark:text-white font-medium">70%</span>
            </div>
            <div className="flex justify-between text-sm">
              <span className="text-gray-500">Generation Time</span>
              <span className="dark:text-white font-medium">~45s</span>
            </div>
          </div>
        </Card>
      </div>
    </div>
  );
};

export default QuizPage;
