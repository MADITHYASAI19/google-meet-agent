# .gitignore for AI Lecture Assistant project
# Node.js / frontend
node_modules/
.dist/
build/
.vite/
.vscode/
.env
.env.*
# Vite cache
.vite/
# Local development files
.DS_Store
# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
# Python / backend
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
env/
.venv/
venv/
# SQLite database (if any)
*.sqlite3
# FastAPI / uvicorn logs
uvicorn.log
# IDE/editor
.idea/
*.sublime-project
*.sublime-workspace
# OS files
Thumbs.db
# Misc
*.log
