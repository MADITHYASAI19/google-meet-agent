APP_NAME="AI Lecture Assistant"
APP_ENV=development
APP_DEBUG=true
APP_VERSION=1.0.0

HOST=127.0.0.1
PORT=8000
API_PREFIX=/api/v1

DATABASE_URL=sqlite:///storage/database.db

STORAGE_PATH=storage/
MEETING_PATH=storage/meetings/
TRANSCRIPT_PATH=storage/transcripts/
NOTES_PATH=storage/notes/
PDF_PATH=storage/pdf/
TEMP_PATH=storage/temp/

LOG_LEVEL=INFO
LOG_PATH=logs/
ENABLE_FILE_LOGGING=true
ENABLE_CONSOLE_LOGGING=true

WHISPER_MODEL=medium
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=auto
WHISPER_BEAM_SIZE=5

DEFAULT_PROVIDER=grok
DEFAULT_MODEL=grok-4-fast
FALLBACK_PROVIDERS=["openai", "gemini"]
MAX_AI_RETRIES=3
AI_TIMEOUT=30

OPENAI_API_KEY=
GROK_API_KEY=
GEMINI_API_KEY=

AUTO_JOIN=false
AUTO_LEAVE=false
ENABLE_MIC=false
ENABLE_CAMERA=false
RECORD_AUDIO=true

ENABLE_ATTENDANCE=true
ATTENDANCE_CONFIDENCE=0.80
ATTENDANCE_TIMEOUT=5

GENERATE_NOTES=true
GENERATE_SUMMARY=true
GENERATE_FLASHCARDS=true
GENERATE_QUIZ=true

AUTO_EXPORT_PDF=true
PDF_THEME=default
PDF_PAGE_SIZE=A4

ENABLE_SEARCH=true
SEARCH_CACHE=true
MAX_SEARCH_RESULTS=100

ENABLE_RAG=false
ENABLE_VECTOR_SEARCH=false
ENABLE_SLIDE_OCR=false
ENABLE_CALENDAR=false
ENABLE_MULTI_USER=false

ENABLE_CORS=true
ENABLE_RATE_LIMIT=false
ENABLE_AUTH=false

MAX_CONCURRENT_MEETINGS=1
MAX_CONCURRENT_AI_REQUESTS=3
MAX_UPLOAD_SIZE_MB=500


 