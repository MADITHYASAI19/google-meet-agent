import logging
import json
import asyncio
import time
from pathlib import Path
from datetime import datetime
from typing import Dict, Any, List, Optional, Tuple

from backend.app.core.event_dispatcher import dispatcher
from backend.app.events.meeting_events import (
    NotesGenerationCompleted, AssignmentGenerationStarted, AssignmentGenerationProgress,
    AssignmentGenerationCompleted, AssignmentGenerationFailed
)
from backend.app.llm.router import llm_router
from backend.app.llm.models import LLMRequest
from backend.app.services.storage_service import storage_manager
from backend.app.config.settings import settings

logger = logging.getLogger("ai_lecture_assistant")

class AssignmentService:
    """
    AI Assignment Generator Service.
    Transforms structured study notes into a professional academic assignment package using the LLMRouter.
    """

    def __init__(self):
        self.settings = settings.assignments

    async def handle_notes_completed(self, event: NotesGenerationCompleted):
        """
        Triggered by NotesGenerationCompleted event to start the assignment generation pipeline.
        """
        meeting_id = event.meeting_id
        notes_package_path = event.notes_package_path

        logger.info(f"Starting assignment generation for meeting: {meeting_id}")
        await dispatcher.publish(AssignmentGenerationStarted(meeting_id=meeting_id))

        try:
            # Stage 1 & 2: Load & Validate
            notes_data = await self._load_notes(notes_package_path)

            # Stage 3: Load Prompts
            system_prompt = await self._load_prompt("assignment_system_prompt.md")
            user_prompt_template = await self._load_prompt("assignment_user_prompt.md")

            # Stage 4: Replace Placeholders
            prompt = self._prepare_prompt(notes_data, user_prompt_template)

            # Stage 5: Generate
            await dispatcher.publish(AssignmentGenerationProgress(
                meeting_id=meeting_id,
                stage="Generating Assignment Content",
                progress_percentage=30.0
            ))

            result = await llm_router.generate(LLMRequest(
                prompt=prompt,
                system_prompt=system_prompt,
                temperature=self.settings.temperature,
                max_tokens=self.settings.max_tokens
            ))

            # Stage 6 & 7: Validate & Normalize
            await dispatcher.publish(AssignmentGenerationProgress(
                meeting_id=meeting_id,
                stage="Validating and Normalizing",
                progress_percentage=60.0
            ))
            assignment_data = self._validate_and_normalize(result.text)

            # Stage 8, 9, 10: Format & Save
            package_path = await self._save_assignment_package(meeting_id, assignment_data, result)

            logger.info(f"Assignment generation completed successfully for meeting: {meeting_id}")
            await dispatcher.publish(AssignmentGenerationCompleted(
                meeting_id=meeting_id,
                assignment_package_path=str(package_path)
            ))

        except Exception as e:
            logger.error(f"Assignment generation failed for meeting {meeting_id}: {str(e)}")
            await dispatcher.publish(AssignmentGenerationFailed(
                meeting_id=meeting_id,
                error_message=str(e)
            ))

    # --- Pipeline Stage Helpers ---

    async def _load_notes(self, package_path: str) -> Dict[str, Any]:
        """Loads notes.json from the provided package path."""
        path = Path(package_path) / "notes.json"
        if not path.exists():
            raise FileNotFoundError(f"Notes file not found at {path}")

        with open(path, "r", encoding="utf-8") as f:
            data = json.load(f)

        if not data or not data.get("summary") and not data.get("key_concepts"):
            raise ValueError("Notes content is empty or invalid.")

        return data

    async def _load_prompt(self, filename: str) -> str:
        """Loads a prompt file from the prompts directory."""
        path = Path("backend/app/prompts") / filename
        if not path.exists():
            raise FileNotFoundError(f"Prompt file not found: {path}")
        return path.read_text(encoding="utf-8")

    def _prepare_prompt(self, notes_data: Dict[str, Any], template: str) -> str:
        """Injects metadata and notes into the user prompt template."""
        notes_text = json.dumps(notes_data, indent=2)

        prompt = template.replace("{{notes}}", notes_text)
        prompt = prompt.replace("{{assignment_type}}", self.settings.assignment_type)
        prompt = prompt.replace("{{difficulty}}", self.settings.difficulty)
        prompt = prompt.replace("{{question_count}}", str(self.settings.question_count))
        prompt = prompt.replace("{{word_limit}}", str(self.settings.word_limit))

        title = notes_data.get("title", "Lecture")
        prompt = prompt.replace("{{lecture_title}}", title)

        return prompt

    def _validate_and_normalize(self, raw_text: str) -> Dict[str, Any]:
        """
        Extracts JSON from LLM response and ensures it matches the assignment schema.
        """
        if "```json" in raw_text:
            raw_text = raw_text.split("```json")[1].split("```")[0].strip()
        elif "```" in raw_text:
            raw_text = raw_text.split("```")[1].split("```")[0].strip()

        try:
            data = json.loads(raw_text)
        except json.JSONDecodeError as e:
            raise ValueError(f"LLM returned malformed JSON: {str(e)}")

        # Required keys for a complete assignment package
        required_keys = ["title", "instructions", "questions", "answer_key", "rubric"]
        for key in required_keys:
            if key not in data:
                raise ValueError(f"Missing required assignment section: {key}")

        return data

    async def _save_assignment_package(self, meeting_id: str, data: Dict[str, Any], llm_response: Any) -> Path:
        """
        Saves the assignment artifacts into the storage directory.
        """
        meeting_dir = storage_manager.get_meeting_folder(meeting_id)
        assignment_dir = meeting_dir / "assignment"
        assignment_dir.mkdir(parents=True, exist_ok=True)

        # 1. assignment.json (The raw structured data)
        with open(assignment_dir / "assignment.json", "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2)

        # 2. assignment.md (Professional Markdown document)
        md_content = f"# {data.get('title', 'Assignment')}\n\n"
        md_content += f"**Course**: AI Lecture Assistant\n"
        md_content += f"**Instructions**: {data.get('instructions', 'No instructions provided.')}\n\n"
        md_content += "---\n\n"

        for i, q in enumerate(data.get("questions", []), 1):
            md_content += f"### Question {i}\n"
            md_content += f"**Marks**: {q.get('marks', 0)} | **Estimated Time**: {q.get('estimated_time', 'N/A')}\n"
            md_content += f"**Type**: {q.get('question_type', 'General')}\n\n"
            md_content += f"{q.get('question', 'No question text provided.')}\n\n"
            md_content += "*(Answer space below)*\n\n"
            md_content += "__________________________________________________________________\n\n"

        md_content += "\n---\n\n"
        total_marks = sum(q.get("marks", 0) for q in data.get("questions", []))
        md_content += f"**Total Marks**: {total_marks}\n"

        with open(assignment_dir / "assignment.md", "w", encoding="utf-8") as f:
            f.write(md_content)

        # 3. answer_key.json
        with open(assignment_dir / "answer_key.json", "w", encoding="utf-8") as f:
            json.dump(data.get("answer_key", {}), f, indent=2)

        # 4. rubric.json
        with open(assignment_dir / "rubric.json", "w", encoding="utf-8") as f:
            json.dump(data.get("rubric", {}), f, indent=2)

        # 5. metadata.json
        metadata = {
            "meeting_id": meeting_id,
            "generation_time": datetime.now().isoformat(),
            "provider": llm_response.provider,
            "model": llm_response.model,
            "token_usage": llm_response.usage.total_tokens,
            "prompt_version": self.settings.prompt_version
        }
        with open(assignment_dir / "metadata.json", "w", encoding="utf-8") as f:
            json.dump(metadata, f, indent=2)

        # 6. statistics.json
        stats = {
            "total_questions": len(data.get("questions", [])),
            "total_marks": total_marks,
            "estimated_completion_time": sum(
                (int(q.get("estimated_time", "0").replace(" mins", "").replace(" min", "").strip())
                 if isinstance(q.get("estimated_time", ""), str) else 0)
                for q in data.get("questions", [])
            ),
            "word_count": len(json.dumps(data).split())
        }
        with open(assignment_dir / "statistics.json", "w", encoding="utf-8") as f:
            json.dump(stats, f, indent=2)

        return assignment_dir

assignment_service = AssignmentService()
